# Copy to .env to override defaults. No secrets belong here:
# passwords and SECRET_KEY are generated into the `secrets` Docker volume on first start.

# Host ports published by nginx (the only published service).
HTTP_PORT=80
HTTPS_PORT=443

# off | selfsigned | provided
#   selfsigned: certificate generated on first start into the secrets volume.
#   provided:   put tls.crt and tls.key in TLS_CERT_DIR.
TLS_MODE=selfsigned
TLS_HOSTNAME=localhost
# Extra subject alternative names for the self-signed cert, e.g. IP:192.168.1.20,DNS:redshadow.lan
TLS_EXTRA_SAN=
TLS_CERT_DIR=./tls

# Comma-separated hostnames the backend accepts (add your LAN name/IP).
ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=INFO

# First Super Admin (created once, only if none exists). If no password file is provided
# the password is generated and printed once in the `migrate` service logs.
BOOTSTRAP_ADMIN_EMAIL=admin@redshadow.local

# Extra origins allowed for CSRF, e.g. https://redshadow.lan:8443 (only needed for non-default hosts).
CSRF_TRUSTED_ORIGINS=

# Shown on the About page. `make up` sets BUILD_ID and BUILD_DATE automatically.
APP_VERSION=1.4.0

# Optional email for notifications (users opt in under the bell). Leave EMAIL_HOST empty to keep email off.
# The SMTP password is never stored here: mount a file and set EMAIL_HOST_PASSWORD_FILE in the backend environment.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=true
EMAIL_FROM=redshadow@localhost
# Public address used for links in emails, e.g. https://redshadow.lan
APP_BASE_URL=
